{
    "name": "blocs\/blocs",
    "type": "library",
    "description": "Laravel Template Engine",
    "keywords": [
        "PHP",
        "Laravel",
        "Template Engine"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "LINEAR JAPAN Co.,Ltd.",
            "email": "admin@linear-jp.biz",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit\/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "laravel\/framework": "Laravel のビューとして使う場合に必要 (>=10)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blocs\\ServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Blocs\\": "src\/",
            "Blocs\\Compiler\\": "compiler\/",
            "Blocs\\Data\\": "data\/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blocs\\Tests\\": "tests\/"
        }
    }
}
